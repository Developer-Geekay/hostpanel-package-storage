[Unit]
Description=HostPanel S3 Object Storage Service
After=network.target hostpanel-api.service

[Service]
Type=simple
User=hostpanel
Group=hostpanel
ExecStart=/bin/sh -c 'if [ -f /opt/hostpanel/backend/venv/bin/python ]; then /opt/hostpanel/backend/venv/bin/python -m uvicorn hostpanel_storage.s3_engine:public_s3_router --host 0.0.0.0 --port 9000; else /usr/bin/python3 -m uvicorn hostpanel_storage.s3_engine:public_s3_router --host 0.0.0.0 --port 9000; fi'
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
